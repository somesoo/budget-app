# Copy to .env and fill in your Supabase project details
# (Supabase → Project Settings → API)
#
# Heads up: the Supabase dashboard shows a Next.js snippet by default, with
# NEXT_PUBLIC_* names. This is a Vite app — only VITE_* variables are read, so
# keep the names below and just paste the values. A new project calls its key
# "publishable" (sb_publishable_...); that is the anon key's replacement and
# goes into VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: the shared account's email, so no phone has to type it. The email
# is not a secret — the password is, and it is never stored here.
# VITE_AUTH_EMAIL=us@example.com

# Server-only (no VITE_ prefix), read by `vercel dev` and `npm run migrate`:
# SUPABASE_SERVICE_ROLE_KEY=   welcome screen + Settings → AI key storage
# DATABASE_URL=                Supabase → Connect → Session pooler
# GEMINI_API_KEY=              or paste one in Settings → AI
