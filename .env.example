# Copy to .env and fill in your Supabase project details
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# The shared account both phones sign in with (Authentication → Users).
# The email is not a secret — the password is, and it is never stored here.
VITE_AUTH_EMAIL=us@example.com
