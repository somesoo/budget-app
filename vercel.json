{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mapa",
      "destination": "/mapa.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/advice.ts": {
      "maxDuration": 30
    },
    "api/plan.ts": {
      "maxDuration": 30
    },
    "api/chat.ts": {
      "maxDuration": 60
    }
  }
}
